{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pwnjam",
  "main": "api/index.ts",
  "compatibility_date": "2025-04-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pwnjam-db",
      "database_id": "your-database-id"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "your-kv-namespace-id"
    }
  ],
  "migrations": [{ "tag": "v1", "new_classes": ["Room"] }],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "vars": {
    "APP_NAME": "PwnJam API",
    "ENVIRONMENT": "production",
    "APP_VERSION": "1.0.0",
    "ROOM_KEY_LENGTH": "6",
    "MAX_USERS_PER_ROOM": "20",
    "ROOM_TIMEOUT_MINUTES": "60",
    "MAX_ROOMS_PER_IP": "5",
    "CORS_ORIGINS": "*",
    "RATE_LIMIT_MAX_REQUESTS": "100",
    "RATE_LIMIT_WINDOW_MS": "60000",
    "WS_HEARTBEAT_INTERVAL": "30000",
    "WS_CONNECTION_TIMEOUT": "60000",
    "MAX_CONNECTIONS_PER_ROOM": "50",
    "API_DUMMY_BASE_URL": "https://internal",
    "CHALLENGE_TIMEOUT_MINUTES": "30",
    "MAX_HINTS_PER_CHALLENGE": "3",
    "BASE_CHALLENGE_POINTS": "100",
    "TIME_BONUS_MULTIPLIER": "1.5",
    "HINT_PENALTY_POINTS": "20",
    "AI_MODEL_TEXT": "@cf/google/gemma-3-12b-it",
    "AI_MODEL_CODE": "@cf/qwen/qwen2.5-coder-32b-instruct",
    "MAX_CHALLENGE_ATTEMPTS": "10",
    "COLLABORATION_BONUS_MULTIPLIER": "1.2",
    "DIFFICULTY_POINT_MULTIPLIERS": "1,1.5,2,3,5"
  },
  "observability": {
    "enabled": false
  }
}
